//! pre-compute the BRDF-LUT given a random low-discrepancy sequence based
// on the Quasi-Monte Carlo method.
//
// THE Paper (https://cdn2.unrealengine.com/Resources/files/2013SiggraphPresentationsNotes-26915738.pdf) show that
// integrating the LUT BRDF is the same as integrating the specular BRDF with a solid-white environment.
// i.e. This leaves two inputs (Roughness and cos θv) and two outputs (a scale and bias to F0), all of which
// are conveniently in the range [0, 1].
//
// N (the normal) is then fix to be (0, 0, 1) for simplicity sake.
//
// Heavily inspired by https://docs.rs/crate/viewport-lib/0.17.0/source/src/shaders/ibl_brdf_lut.wgsl
#version 450

const float PI = 3.14159265359;
const uint  SAMPLE_COUNT = 1024u;
const vec3 N = vec3(0, 0, 1);

layout(set = 0, binding = 0, rg16f) uniform writeonly image2D lut;

// van der Corput radical inverse in base 2
float RadicalInverse_VdC(uint bits) 
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

/*
	* Hammersley sequence: give a low-discrepancy sequence.
	*
	* @param i: which point to generate
	* @param n: how many points in total
*/
vec2 Hammersley(uint i, uint N)
{
    return vec2(float(i)/float(N), RadicalInverse_VdC(i));
} 

/*
	* Generate sample vectors biased towards the general reflection orientation
	* of the microsurface halfway vector based on the surface's roughness (squared).
	* THIS ONE IS A SIMPLIFICATION FOR THE BRDF LUT USE CASE.
	*
	* @param alpha: material roughness squared.
	* @param Xi: hammersley evaluation for i
*/
vec3 ImportanceSampleGGX_LUT(vec2 Xi, float alpha)
{
	float phi = 2.0 * PI * Xi.x;
	float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (alpha * alpha - 1.0) * Xi.y));
	float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

	// BRDF-LUT simplification. (for cubemap the function is not the same)
	return vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
}

/*
	* Smith geometry term for IBL
	*
	* @param NdotV
	* @param NdotL
	* @param alpha: material roughness squared
*/
float geometrySmithIBL(float NdotV, float NdotL, float alpha)
{
    float k = alpha / 2.0;

    float ggxV = NdotV / (NdotV * (1.0 - k) + k);
    float ggxL = NdotL / (NdotL * (1.0 - k) + k);

    return ggxV * ggxL;
}

vec2 integratedBRDF(float NdotV, float roughness)
{
	vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
	float alpha = roughness * roughness;

	float A_OUT = 0.0;
	float B_OUT = 0.0;

	for (uint i = 0u; i < SAMPLE_COUNT; i++) {
		vec2 Xi = Hammersley(i, SAMPLE_COUNT);
		vec3 H = ImportanceSampleGGX_LUT(Xi, alpha);
		vec3 L = normalize(2.0 * dot(V, H) * H - V);

		float NdotL = max(L.z, 0.0);
		float NdotH = max(H.z, 0.0);
		float VdotH = max(dot(V, H), 0.0);

		if (NdotL > 0.0) {
			float G = geometrySmithIBL(NdotV, NdotL, alpha);
			float G_Vis = (G * VdotH) / max(NdotH * NdotV, 0.0001);
			float Fc = pow(1.0 - VdotH, 5.0);

			A_OUT += (1.0 - Fc) * G_Vis;
			B_OUT += Fc * G_Vis;
		}
	}

	return vec2(A_OUT, B_OUT) / SAMPLE_COUNT;
}

void main()
{
	ivec2 dims = imageSize(lut);
	ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
	if (gid.x >= dims.x || gid.y >= dims.y) return;

	float NdotV = (float(gid.x) + 0.5) / float(dims.x);
	float roughness = (float(gid.y) + 0.5) / float(dims.y);

	vec2 ab = integratedBRDF(NdotV, roughness);
	imageStore(lut, gid, vec4(ab, 0.0, 0.0));
}