//! Pre-filter the environment cubemap into a chain of increasingly rough
//! specular reflections — the first half of the split-sum approximation.
//
// One dispatch per mip level, each with its own storage view and a roughness
// pushed as a constant. Samples are drawn from the GGX lobe, and each one reads
// the source at a mip level derived from its own probability density: without
// that, a bright pixel caught by a sparse sample turns into an isolated firefly.
//
// Follows https://github.com/Nadrin/PBR/blob/master/data/shaders/glsl/spmap_cs.glsl
// Mip-filtered importance sampling: GPU Gems 3, chapter 20, section 20.4.
#version 450

const float PI = 3.14159265358979;
const float TWO_PI = 2 * PI;
const uint SAMPLE_COUNT = 1024u;

layout(local_size_x=16, local_size_y=16) in;

layout(set=0, binding=0) uniform textureCube envTexture;
layout(set=0, binding=1) uniform sampler envSampler;
layout(set=0, binding=2) restrict writeonly uniform imageCube prefiltered;

layout(push_constant) uniform PushConstants {
	float roughness;
} pcs;

/*
	* Compute Van der Corput radical inverse
	* See: http://holger.dammertz.org/stuff/notes_HammersleyOnHemisphere.html
*/
float radicalInverse_VdC(uint bits)
{
	bits = (bits << 16u) | (bits >> 16u);
	bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
	bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
	bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
	bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
	return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

// Sample i-th point from Hammersley point set of NumSamples points total.
vec2 hammersley(uint i, uint n)
{
	return vec2(float(i) / float(n), radicalInverse_VdC(i));
}

/*
	* Half-vector drawn from the GGX lobe, in tangent space (N = +Z).
	*
	* @param Xi: Hammersley point
	* @param roughness: perceptual roughness [0, 1]
*/
vec3 importanceSampleGGX(vec2 Xi, float roughness)
{
	float alpha = roughness * roughness;

	float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (alpha * alpha - 1.0) * Xi.y));
	float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
	float phi = TWO_PI * Xi.x;

	return vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
}

/*
	* GGX normal distribution, doubling as the probability density of the
	* half-vectors importanceSampleGGX draws.
*/
float ndfGGX(float NdotH, float roughness)
{
	float alpha = roughness * roughness;
	float a2 = alpha * alpha;

	float denom = NdotH * NdotH * (a2 - 1.0) + 1.0;
	return a2 / (PI * denom * denom);
}

/*
	* Direction pointed at by the texel this invocation owns.
	*
	* Calculate normalized sampling direction vector based on current fragment coordinates (gl_GlobalInvocationID.xyz).
	* This is essentially "inverse-sampling": we reconstruct what the sampling vector would be if we wanted it to "hit"
	* this particular fragment in a cubemap.
	*
	* Same as the one in equirect_to_cubemap.comp
*/
vec3 getSamplingVector()
{
	vec2 st = (vec2(gl_GlobalInvocationID.xy) + 0.5) / vec2(imageSize(prefiltered));
	vec2 uv = 2.0 * vec2(st.x, 1.0 - st.y) - vec2(1.0);

	vec3 dir;
	switch (gl_GlobalInvocationID.z) {
		case 0u: dir = vec3(1.0, uv.y, -uv.x); break;
		case 1u: dir = vec3(-1.0, uv.y, uv.x); break;
		case 2u: dir = vec3(uv.x, 1.0, -uv.y); break;
		case 3u: dir = vec3(uv.x, -1.0, uv.y); break;
		case 4u: dir = vec3(uv.x, uv.y, 1.0); break;
		default: dir = vec3(-uv.x, uv.y, -1.0); break;
	}

	return normalize(dir);
}

/*
	* Compute orthonormal basis for converting from tanget/shading space to world space.
	*
	* See: Building an Orthonormal Basis, Revisited
*/
void computeBasisVector(const vec3 N, out vec3 B1, out vec3 B2)
{
	float sign = N.z >= 0 ? 1.0 : -1.0;
	float a = -1.0 / (sign + N.z);
	float b = N.x * N.y * a;

	B1 = vec3(1.0 + sign * N.x * N.x * a, sign * b, -sign * N.x);
	B2 = vec3(b, sign + N.y * N.y * a, -N.y);   
}

/*
	* Move a tangent-space direction into world space, given the basis built
	* around N.
*/
vec3 tangentToWorld(const vec3 v, const vec3 T, const vec3 B, const vec3 N)
{
	return T * v.x + B * v.y + N * v.z;
}

void main()
{
	ivec2 size = imageSize(prefiltered);
	if (gl_GlobalInvocationID.x >= size.x || gl_GlobalInvocationID.y >= size.y) return;

	vec3 N = getSamplingVector();
	vec3 Lo = N;

	vec3 T, B;
	computeBasisVector(N, T, B);

	// Solid angle associated with a single cubemap texel at zero mipmap level.
	// This will come in handy for importance sampling below.
	vec2 inputSize = vec2(textureSize(samplerCube(envTexture, envSampler), 0));
	float texelSolidAngle = 4.0 * PI / (6.0 * inputSize.x * inputSize.y);

	vec3 color = vec3(0);
	float weight = 0;

	for(uint i=0; i<SAMPLE_COUNT; ++i) {
		vec2 u = hammersley(i, SAMPLE_COUNT);
		vec3 Lh = tangentToWorld(importanceSampleGGX(u, pcs.roughness), T, B, N);

		// Compute incident direction (Li) by reflecting viewing direction (Lo) around half-vector (Lh).
		vec3 Li = 2.0 * dot(Lo, Lh) * Lh - Lo;

		float NdotL = dot(N, Li);
		if (NdotL <= 0) continue;

		// Use Mipmap Filtered Importance Sampling to improve convergence.
		// See: https://developer.nvidia.com/gpugems/GPUGems3/gpugems3_ch20.html, section 20.4
		float pdf = ndfGGX(max(dot(N, Lh), 0.0), pcs.roughness) * 0.25;
		float sampleSolidAngle = 1.0 / (float(SAMPLE_COUNT) * pdf);
		float mipLevel = max(0.5 * log2(sampleSolidAngle / texelSolidAngle) + 1.0, 0.0);

		color += textureLod(samplerCube(envTexture, envSampler), Li, mipLevel).rgb * NdotL;
		weight += NdotL; 
	}
	color /= weight;

	imageStore(prefiltered, ivec3(gl_GlobalInvocationID), vec4(color, 1.0));
}